<!DOCTYPE html>  
<html lang="es">  
<head>  
  <meta charset="UTF-8" />  
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />  
  <title>Minecraft Addons Hub</title>  
  <style>  
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');  
  
    * {  
      margin: 0;  
      padding: 0;  
      box-sizing: border-box;  
      -webkit-tap-highlight-color: transparent;  
    }  
  
    body {  
      background: linear-gradient(180deg, #0a1f0a 0%, #051505 100%);  
      min-height: 100vh;  
      font-family: 'Segoe UI', system-ui, sans-serif;  
      color: #c8e6c8;  
      padding: 16px 12px 40px;  
    }  
  
    .header {  
      text-align: center;  
      margin-bottom: 22px;  
      padding-top: 10px;  
    }  
  
    .logo {  
      font-family: 'Press Start 2P', cursive;  
      font-size: 22px;  
      line-height: 1.4;  
      color: #4cff4c;  
      text-shadow:   
        0 0 8px rgba(76, 255, 76, 0.6),  
        2px 2px 0 #0a3a0a;  
      letter-spacing: 1px;  
    }  
  
    .logo span {  
      display: block;  
      font-size: 18px;  
      margin-top: 4px;  
    }  
  
    .search-box {  
      background: #1a2e1a;  
      border: 2px solid #2a4a2a;  
      border-radius: 14px;  
      padding: 14px 18px;  
      margin-bottom: 22px;  
      display: flex;  
      align-items: center;  
      gap: 10px;  
    }  
  
    .search-box input {  
      background: transparent;  
      border: none;  
      outline: none;  
      color: #a0c8a0;  
      font-size: 15px;  
      width: 100%;  
      font-family: inherit;  
    }  
  
    .search-box input::placeholder {  
      color: #5a7a5a;  
    }  
  
    .addons-list {  
      display: flex;  
      flex-direction: column;  
      gap: 14px;  
    }  
  
    .addon-card {  
      background: #152515;  
      border: 2px solid #2a4a2a;  
      border-radius: 16px;  
      padding: 16px;  
      position: relative;  
      transition: transform 0.15s, border-color 0.15s;  
    }  
  
    .addon-card:active {  
      transform: scale(0.98);  
      border-color: #3a6a3a;  
    }  
  
    .addon-header {  
      display: flex;  
      justify-content: space-between;  
      align-items: flex-start;  
      margin-bottom: 8px;  
      gap: 8px;  
    }  
  
    .addon-name {  
      font-family: 'Press Start 2P', cursive;  
      font-size: 13px;  
      color: #4cff4c;  
      line-height: 1.35;  
      text-shadow: 1px 1px 0 #0a2a0a;  
    }  
  
    .tag {  
      font-size: 10px;  
      font-weight: 700;  
      padding: 4px 8px;  
      border-radius: 20px;  
      background: #1e3a1e;  
      color: #7dff7d;  
      white-space: nowrap;  
      border: 1px solid #2a5a2a;  
      letter-spacing: 0.5px;  
    }  
  
    .tag.ui { background: #1a2e3a; color: #7dc8ff; border-color: #2a4a6a; }  
    .tag.weapons { background: #3a1e1e; color: #ff7d7d; border-color: #5a2a2a; }  
    .tag.camera { background: #2a1e3a; color: #c87dff; border-color: #4a2a6a; }  
    .tag.utility { background: #3a3a1e; color: #ffd07d; border-color: #5a5a2a; }  
  
    .version {  
      font-size: 12px;  
      color: #7a9a7a;  
      margin-bottom: 8px;  
    }  
  
    .desc {  
      font-size: 13.5px;  
      line-height: 1.45;  
      color: #b0d0b0;  
      margin-bottom: 14px;  
    }  
  
    .btn-download {  
      display: block;  
      width: 100%;  
      background: #22c55e;  
      color: #0a1f0a;  
      font-weight: 800;  
      font-size: 15px;  
      text-align: center;  
      padding: 13px;  
      border-radius: 12px;  
      text-decoration: none;  
      border: none;  
      letter-spacing: 0.5px;  
      box-shadow: 0 4px 0 #15803d;  
      transition: all 0.1s;  
    }  
  
    .btn-download:active {  
      transform: translateY(3px);  
      box-shadow: 0 1px 0 #15803d;  
    }  
  
    .footer {  
      text-align: center;  
      margin-top: 30px;  
      font-size: 11px;  
      color: #4a6a4a;  
    }  
  </style>  
</head>  
<body>  
  <div class="header">  
    <div class="logo">  
      MINECRAFT  
      <span>ADDONS HUB</span>  
    </div>  
  </div>  
  
  <div class="search-box">  
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5a7a5a" stroke-width="2.5">  
      <circle cx="11" cy="11" r="8"></circle>  
      <path d="m21 21-4.35-4.35"></path>  
    </svg>  
    <input type="text" id="searchInput" placeholder="Buscar addon..." oninput="filterAddons()" />  
  </div>  
  
  <div class="addons-list" id="addonsList">  
  
    <!-- 1. Transparent Touch Buttons -->  
    <div class="addon-card" data-name="transparent touch buttons">  
      <div class="addon-header">  
        <div class="addon-name">TRANSPARENT TOUCH BUTTONS</div>  
        <div class="tag ui">UI</div>  
      </div>  
      <div class="version">Versión: 1.21+</div>  
      <div class="desc">Botones táctiles transparentes para una interfaz más limpia y moderna.</div>  
      <a href="https://mcpedl.com/transparent-touch-buttons/" class="btn-download" target="_blank">DESCARGAR</a>  
    </div>  
  
    <!-- 2. Advanced Nichirin -->  
    <div class="addon-card" data-name="advanced nichirin">  
      <div class="addon-header">  
        <div class="addon-name">ADVANCED NICHIRIN</div>  
        <div class="tag weapons">WEAPONS</div>  
      </div>  
      <div class="version">Versión: 1.21+</div>  
      <div class="desc">Espada Nichirin avanzada estilo Demon Slayer con efectos especiales.</div>  
      <a href="https://mcpedl.com/advanced-nichirin/" class="btn-download" target="_blank">DESCARGAR</a>  
    </div>  
  
    <!-- 3. White Outline -->  
    <div class="addon-card" data-name="white outline">  
      <div class="addon-header">  
        <div class="addon-name">WHITE OUTLINE</div>  
        <div class="tag ui">UI</div>  
      </div>  
      <div class="version">Versión: 1.21+</div>  
      <div class="desc">Cambia el contorno de selección de bloques a blanco para mejor visibilidad.</div>  
      <a href="https://mcpedl.com/" class="btn-download" target="_blank">DESCARGAR</a>  
    </div>  
  
    <!-- 4. GoPro Perspective (NUEVO) -->  
    <div class="addon-card" data-name="gopro perspective">  
      <div class="addon-header">  
        <div class="addon-name">GOPRO PERSPECTIVE</div>  
        <div class="tag camera">CAMERA</div>  
      </div>  
      <div class="version">Versión: 1.21+</div>  
      <div class="desc">Añade 3 nuevas perspectivas de cámara (estacionaria, hombro izquierdo y derecho) perfectas para cinemáticas.</div>  
      <a href="https://mcpedl.com/gopro-perspective/" class="btn-download" target="_blank">DESCARGAR</a>  
    </div>  
  
    <!-- 5. Portal Gun actualizado -->  
    <div class="addon-card" data-name="portal gun">  
      <div class="addon-header">  
        <div class="addon-name">PORTAL GUN</div>  
        <div class="tag utility">UTILITY</div>  
      </div>  
      <div class="version">Versión: 1.1.1 (Actualizado)</div>  
      <div class="desc">Portal Gun completo estilo Rick & Morty + Portal. Crea portales, viaja entre dimensiones y guarda ubicaciones. ¡Versión más reciente!</div>  
      <a href="https://mcpedl.com/portal-gun-addon-tek/" class="btn-download" target="_blank">DESCARGAR</a>  
    </div>  
  
    <!-- 6. Dynamic Lights (el que yo elegí) -->  
    <div class="addon-card" data-name="dynamic lights">  
      <div class="addon-header">  
        <div class="addon-name">DYNAMIC LIGHTS</div>  
        <div class="tag utility">UTILITY</div>  
      </div>  
      <div class="version">Versión: 1.21+</div>  
      <div class="desc">Las antorchas, linternas y objetos brillantes iluminan de verdad mientras los llevas. ¡Ya no más oscuridad!</div>  
      <a href="https://mcpedl.com/" class="btn-download" target="_blank">DESCARGAR</a>  
    </div>  
  
  </div>  
  
  <div class="footer">  
    Minecraft Addons Hub • Hecho con 💚  
  </div>  
  
  <script>  
    function filterAddons() {  
      const query = document.getElementById('searchInput').value.toLowerCase().trim();  
      const cards = document.querySelectorAll('.addon-card');  
        
      cards.forEach(card => {  
        const name = card.getAttribute('data-name');  
        if (name.includes(query) || query === '') {  
          card.style.display = 'block';  
        } else {  
          card.style.display = 'none';  
        }  
      });  
    }  
  </script>  
</body>  
</html>  
